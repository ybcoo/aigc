# Docker Compose settings. Copy this file to .env in this directory.
# These are examples, not real credentials. Change the password before deployment.
COMPOSE_PROJECT_NAME=aigc
HOST_BIND_IP=127.0.0.1
FRONTEND_PORT=3000
BACKEND_PORT=3001

POSTGRES_USER=postgres
POSTGRES_DB=aigc
# Use a random hex password (openssl rand -hex 24) to avoid URL escaping issues.
POSTGRES_PASSWORD=change_me_before_deploy
# Optional: override the derived connection URL, e.g. for an external database.
# URL-encode special characters in the username/password when setting this.
# DATABASE_URL=postgresql://postgres:encoded_password@db:5432/aigc?schema=public

# Browser-facing URLs, not Docker service names. Keep these in sync with ports.
NUXT_PUBLIC_API_BASE=http://localhost:3001/api
FRONTEND_ORIGIN=http://localhost:3000
# Public backend origin serving /uploads, required for local video/audio references.
# localhost and Docker service names are NOT accessible to AI providers.
PUBLIC_ASSET_BASE_URL=

# local: persistent Docker uploads volume. oss: Cloudflare R2.
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_BUCKET=aigc
R2_REGION=auto
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
