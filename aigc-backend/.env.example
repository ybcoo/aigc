# Local development settings. Docker Compose uses the .env at the AIGC root.
PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
# Public origin serving /uploads, required when local video/audio is used as a provider reference.
PUBLIC_ASSET_BASE_URL=

# local: /uploads/aigc on this server. oss: Cloudflare R2, S3-compatible storage.
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_BUCKET=aigc
R2_REGION=auto
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public custom domain connected to the bucket; not the S3 API endpoint.
R2_PUBLIC_BASE_URL=

# Prisma reads DATABASE_URL, not separate DB_HOST/DB_USER/DB_PASSWORD variables.
# Replace the example password and URL-encode special characters in credentials.
DATABASE_URL="postgresql://postgres:change_me@localhost:5432/aigc?schema=public"
